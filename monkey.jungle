project.manifest = manifest.xml

# One build for every device. Devices with the 64KB widget memory cap
# (the old-devices list, below) get the lean build: the code marked
# (:exclude_oldwidget) is stripped and the (:oldwidget_only) stand-ins are
# compiled in instead (no GRAPH/BASE/COLOR/COUNTER/FORMULAS/HISTORY/QR).
# Everything else gets the full build.
#
# base.* applies to every device; each device line below overrides it.
base.excludeAnnotations = oldwidget_only

approachs60.excludeAnnotations = exclude_oldwidget
d2bravo.excludeAnnotations = exclude_oldwidget
d2bravo_titanium.excludeAnnotations = exclude_oldwidget
